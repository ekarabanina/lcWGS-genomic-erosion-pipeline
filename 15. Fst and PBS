## Step 7: Plot PBS distributions as Manhattan plots in R (PBS values vs genomic position). 
# Below the script is only for POST group. Similarly, plotting is done for all other groups.

# If you are not following the calculations in Step 6 above, load libraries and data to R.
install.packages("ggplot2","dplyr")
library(ggplot2)
library(dplyr)
pbs <- read.table("pbs_stats2_2x.txt", header = TRUE)

# Load ref genome .fai file for chr lengths
fai <- read.table("/path/to/ref/genome/GCF_900496995.4_bAquChr1.4_genomic.fna.fai", sep = "\t", head = FALSE)
head (fai)
colnames(fai) <- c("Chr", "Chr_len", "Byte_offset", "Bases_per_line", "Bytes_per_line")

chr_lengths <- fai %>%
  select(Chr, Chr_len) %>%
  mutate(chr_start = lag(cumsum(Chr_len), default = 0))
head(chr_lengths)

# Create a file that includes only chromosomes present in PBS dataset and assignt them sequential numbers (1-26, i.e., autosomes).
chr_lengths_plot <- fai %>%
  filter(Chr %in% pbs$chr) %>%
  select(Chr, Chr_len) %>%
  mutate(chr_num = row_number(),         # 1..26
         chr_start = lag(cumsum(Chr_len), default = 0))
head(chr_lengths_plot)

# Add chromosome information column to the PBS data file
pbs_plot <- pbs %>%
  left_join(chr_lengths_plot, by = c("chr" = "Chr")) %>%
  mutate(cumPos = midPos + chr_start)
head(pbs_plot)

# Calculate chromosome midpoints for placing X-axis labels and define positions of these labels (for plotting later)
chr_midpoints <- chr_lengths_plot$chr_start +
  chr_lengths_plot$Chr_len / 2
chr_labels <- chr_lengths_plot$chr_num

# Calculate threshold using original PBS values (PRE = PBS0, BOT = PBS1, POST = PBS2)
mean_pbs <- mean(pbs_plot$PBS2, na.rm = TRUE)
sd_pbs <- sd(pbs_plot$PBS2, na.rm = TRUE)
threshold_pbs <- mean_pbs + 4 * sd_pbs
threshold_pbs

# Plot PBS
ggplot(pbs_plot, aes(x = cumPos, y = PBS2, color = factor(chr_num))) +
  geom_point(size = 1) +
  scale_color_manual(
    values = rep(c("grey30", "skyblue"),
                 length.out = length(unique(pbs_plot$chr_num)))
  ) +
  scale_x_continuous(
    breaks = chr_midpoints,
    labels = chr_labels
  ) +
  geom_hline(yintercept = 0, linetype = "dashed",
             color = "black") +
  geom_hline(yintercept = threshold_pbs, linetype = "dashed",
             color = "red") +
  theme_classic() +
  labs(
    x = "Chromosome",
    y = "PBS (20 kb window)",
    title = "POST"
  ) +
  theme(legend.position = "none")
