## PBS
#!/bin/bash
#SBATCH --job-name=pbs_stats2
#SBATCH --output=pbs_stats2_%j.txt
#SBATCH --error=pbs_stats2_%j.txt
#SBATCH --account=<name>
#SBATCH --partition=small
#SBATCH --time=02:00:00
#SBATCH --ntasks=1
