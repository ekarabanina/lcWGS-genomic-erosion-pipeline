## Step 6: Calculate weighted Fst and PBS in R, plot PBS

# Install and load packages
install.packages("ggplot2","dplyr")
library(ggplot2)
library(dplyr)

#---------------------------------------------------------------------------------------------------------------
## FST
# Below the script is for one group pair (PRE-BOT). Similarly, analysis is done for all other group pairs.

## Part 1: Loading and inspecting data
# Load and inspect data
fst_PRE_BOT <- read.table("fst_stats2_PRE-BOT.txt", header = TRUE)
head(fst_PRE_BOT)

# Plot distribution of Fst values
hist(
  fst_PRE_BOT$Fst,
  breaks = 30,
  main = "Distribution of Fst values (PRE-BOT)",
  xlab = "Fst",
  col = "grey80",
  border = "grey40"
)

# Check if there are windows with very few sites
range(fst_PRE_BOT$Nsites)
sum(fst_PRE_BOT$Nsites < 100) #how many windows have less than 100 sites

# Show lines with low Nsites, check if Fst values are outliers
summary(fst_PRE_BOT$Fst) #check distribution of Fst values
subset(fst_PRE_BOT, Nsites < 100) #here the values are ok, so we can keep them


## Part 2: Calculating weighted mean Fst
#PRE-BOT
weighted_Fst_PRE_BOT <- sum(fst_PRE_BOT$Fst * fst_PRE_BOT$Nsites) / sum(fst_PRE_BOT$Nsites)
weighted_Fst_PRE_BOT

#alternatively, use R's function "weighted.mean":
weighted_Fst_PRE_BOT <- weighted.mean(fst_PRE_BOT$Fst, fst_PRE_BOT$Nsites)
weighted_Fst_PRE_BOT


#---------------------------------------------------------------------------------------------------------------
## PBS
## Part 1: Loading and inspecting data
pbs <- read.table("pbs_stats2_2x.txt", header = TRUE)
head(pbs)

#Check high PBS positions
range (pbs$PBS0) #for PRE
range (pbs$PBS1) #for BOT
range (pbs$PBS2) #for POST

pbs_PRE_high <- subset(pbs, pbs$PBS0 > 0.10)
write.table(pbs_PRE_high, "pbs_PRE_2x_over0.10.csv", row.names = FALSE, sep = ";")
pbs_POST_high <- subset(pbs, pbs$PBS2 > 0.10)
write.table(pbs_POST_high, "pbs_POST_2x_over0.10.csv", row.names = FALSE, sep = ";")


## Part 2: Calculating weighted mean PBS values
weighted_pbs_PRE <- weighted.mean(pbs$PBS0, pbs$Nsites)
weighted_pbs_PRE
sum(pbs$PBS0*pbs$Nsites)/sum(pbs$Nsites) #manual calculation

weighted_pbs_BOT <- weighted.mean(pbs$PBS1, pbs$Nsites)
weighted_pbs_BOT

weighted_pbs_POST <- weighted.mean(pbs$PBS2, pbs$Nsites)
weighted_pbs_POST


