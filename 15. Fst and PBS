## PBS
#!/bin/bash
#SBATCH --job-name=pbs
#SBATCH --output=pbs_%j.txt
#SBATCH --error=pbs_%j.txt
#SBATCH --account=<name>
#SBATCH --partition=small
#SBATCH --time=24:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=3G
#SBATCH --nodes=1

echo "Defining paths and variables..."
input_ml="/path/to/ml/file" #produced per group pair in Step 3 above
out_dir="/path/to/save/results"

echo "Loading angsd module..."
module load angsd

echo "Running realSFS..."
realSFS fst index -fold 1 \
$input_dir/PRE/doSaf_PRE.saf.idx \
$input_dir/BOT/doSaf_BOT.saf.idx \
$input_dir/POST/doSaf_POST.saf.idx \
-sfs $input_dir/realsfs_PRE-BOT.ml \
-sfs $input_dir/realsfs_PRE-POST.ml \
-sfs $input_dir/realsfs_BOT-POST.ml \
-fstout $out_dir/pbs \
2> $out_dir/pbs.errors

echo "Done!"


