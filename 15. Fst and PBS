## Step 5: Run realSFS fst stats to extract Fst and PBS from binary files. Here, in non-overlapping windows (using stats2 option).

# FST
# Below is the example for one pairwise comparison. Similarly, analysis is done for all other group comparisons.

#!/bin/bash
#SBATCH --job-name=fstIndex_PRE-BOT_1_stats
#SBATCH --output=fstIndex_PRE-BOT_1_stats_%j.txt
#SBATCH --error=fstIndex_PRE-BOT_1_stats_%j.txt
#SBATCH --account=<name>
#SBATCH --partition=small
#SBATCH --time=72:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=500M
#SBATCH --nodes=1

echo "Defining paths and variables..."
dir="/path/to/fst/files" #produced in Step 4 above.

echo "Loading angsd module..."
module load angsd

echo "Running realSFS..."
realSFS fst stats2 $dir/fst_PRE-BOT.fst.idx -win 20000 -step 20000 &> $dir/fstIndex_PRE-BOT_stats.log

echo "Done!"

