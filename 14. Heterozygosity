## Part 2: Plot (violin plots with box plots, where average values are marked in addition to medians).
# For plotting heterozygosity across groups, I created a new table, which, in addition to sample names and heterozygosity caluclations from above, included columns with group assignment (PRE, BOT, POST), and years of samples. I called this table "heterozygosity_v2_forR.csv"
het_groups <- read.csv("heterozygosity_v2_forR.csv", header = TRUE, sep = ";")
head (het_groups)
colour <- c("POST" = "#440154", "BOT" = "#FFDD44", "PRE" = "#21918c")
het_groups$Group <- factor(het_groups$Group, levels = c("PRE", "BOT", "POST" ))

ggplot(het_groups, aes(x = Group, y = mean_het)) +
  geom_violin(aes(fill = Group), alpha = 0.6, trim = FALSE) +
  geom_boxplot(width = 0.1, outlier.shape = NA , alpha = 0.9) +
  stat_summary(fun = mean, geom = "point", 
               shape = 8, size = 3, colour = "red") + 
  geom_point(colour = "black", size = 1.7, position = position_jitter(width = 0.07)) +
  scale_fill_manual(values = colour, name = "Time period") +
  labs(x = NULL, 
       y = "Individual genome-wide heterozygosity",
       title = "Full depth") +
  scale_y_continuous(labels = scales::number_format(accuracy = 0.0001)) + #optional line to display heterozygosity in non-scientific format
  theme_minimal() +
  theme(
    axis.title = element_text(size = 14),
    axis.text = element_text(size = 12),
    legend.position = "none",
    panel.grid.major.x = element_blank())

