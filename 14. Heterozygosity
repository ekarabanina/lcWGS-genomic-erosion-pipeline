# Estimating individual genome-wide heterozygosity with ANGSD

# Programs: ANGSD 0.940, RStudio

# All cluster jobs were performed on Puhti, CSC supercomputer: https://csc.fi/en/

# Steps:
# 1. Run doSaf per sample
# 2. Create a list with paths to Saf files
# 3. Run realSFS per sample with 100 bootstrap replications
# 4. Merge output files from realSFS to one file
# 5. Do calculations, statistics, and plotting in R

######################################################################################
## Step 1: Run doSaf per sample
#!/bin/bash
#SBATCH --job-name=doSaf_2x_persample
#SBATCH --output=doSaf_2x_persample_%j.txt
#SBATCH --error=doSaf_2x_persample_%j.txt
#SBATCH --account=<name>
#SBATCH --partition=small
#SBATCH --time=72:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=1G
#SBATCH --nodes=1

echo "Defining paths and variables..."
ref="/path/to/reference_genome.fna"
input_dir="/path/to/bamfiles"
out_dir="/path/to/save/results"

echo "Loading angsd module..."
module load angsd

for bamfile in $input_dir/*.bam
do
sample=$(basename $bamfile _2x.bam)

echo "Running -doSaf for $sample..."
angsd -P 8 -i $bamfile -anc $ref -ref $ref \
-out $out_dir/doSaf_2x_${sample} \
-GL 1 -doSaf 1 \
-remove_bads 1 -uniqueOnly 1 -only_proper_pairs 1 \
-baq 1 -C 50 \
-minMapQ 30 -minQ 20 \
-doCounts 1 \
-setMinDepthInd 1 -setMaxDepthInd 8 \
&> $out_dir/doSaf_2x_${sample}.log

if [ $? -eq 0 ]; then
echo "$sample processed successfully"
else
echo "Error processing $sample"
fi

done

echo "Done!"

######################################################################################
## Step 2: Create a list with paths to produced Saf files
A list should contain full paths to saf files (.saf.idx) produced in Step 1, so that one file is on one line. 
For example, using the ls -1 command:
ls -1 /dir/*.saf.idx > safFiles_list.txt

######################################################################################
## Step 3: Run realSFS per sample with 100 bootstrap replications
#!/bin/bash
#SBATCH --job-name=realsfs_2x_persample_array
#SBATCH --output=realsfs_2x_persample_array_%A_%a.txt
#SBATCH --error=realsfs_2x_persample_array_%A_%a.txt
#SBATCH --account=<name>
#SBATCH --partition=small
#SBATCH --time=72:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=20
#SBATCH --mem=40G
#SBATCH --array=1-26

echo "Defining paths and variables..."
dir="/path/to/output/dir"
safFiles="/path/to/safFiles_list.txt" #from Step 2 above

echo "Loading angsd module..."
module load angsd

safFile=$(sed -n "${SLURM_ARRAY_TASK_ID}p" $safFiles)
sample=$(basename "$safFile" .saf.idx | sed 's/^doSaf_2x_//')

echo "$(date): Running realSFS for $sample..."
realSFS -cores 20 -fold 1 -bootstrap 100 $safFile 2> $dir/realsfs_2x_${sample}.errors.log | \
awk -v sample=$sample '{print sample, $0}' > $dir/realsfs_2x_${sample}.ml

echo "$(date): Finished $sample!"

######################################################################################
## Step 4: Merge output files from realSFS to one file
The output from Step 3 created .ml files for each sample. These should be merged to be imported to R.
For example, merging can be done with cat command
cat *.ml > all_v2.ml


