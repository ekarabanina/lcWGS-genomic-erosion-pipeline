## Part 3: Perform statistical comparison of heterozygosity between groups
# Load the data (if needed again)
het_groups <- read.csv("heterozygosity_2x_forR.csv", header = TRUE, sep = ";")
het_groups

# Check if data has normal distribution or not. There are two common normality tests: the Kolmogorov-Smirnov (KS) and Shapiro-Wilk test. 
#The Shapiro-Wilk test is preferred for small samples (n is less than or equal to 50). 
#For larger samples, the Kolomogrov-Smirnov test is recommended.

shapiro.test(het_groups$mean_het)
#if the test is significant, the distribution is non-normal. Here, it is significant.

# Assign datasets and calculate mean and median per group
het_PRE <- het_groups$mean_het [het_groups$Group == "PRE"]
het_PRE
mean(het_PRE)
median(het_PRE)

het_BOT <- het_groups$mean_het  [het_groups$Group == "BOT"]
het_BOT
mean(het_BOT)
median(het_BOT)

het_POST <- het_groups$mean_het  [het_groups$Group == "POST"]
het_POST
mean(het_POST)
median(het_POST)

# Perform Kruskal-Wallis test for simultaneous comparison of three groups. Kruskal-Wallis test is used for multiple independent group and non-parametric data
kruskal.test(list(het_PRE, het_BOT, het_POST))

# Perform Mann-Whitney U test (=Wilcox sum rank test) for pairwise comparison. Mann-Whitney U test is used for comparing 2 independent groups and data with non-normal distribution
# PRE-BOT
MWT_PRE_BOT = wilcox.test(het_PRE, het_BOT, exact = FALSE)
print (MWT_PRE_BOT)
#Exact distribution is better for small sample sizes (n<50). Normal distribution will have a standard deviation of around 7-8, and if sample size is small it can cause issues if the data has strange values. That is because st dev depends on sample size and not the actual values. 
#By default (if exact is not specified), an exact p-value is computed if the samples contain less than 50 finite values and there are no ties. Otherwise, a normal approximation is used.
# Using normal approximation and continuity correction (i.e. exact=FALSE). This should result in more precise p-values.

# PRE-POST
MWT_PRE_POST = wilcox.test(het_PRE, het_POST, exact=FALSE)
print (MWT_PRE_POST)

# BOT-POST
MWT_BOT_POST = wilcox.test(het_BOT, het_POST, exact=FALSE)
print (MWT_BOT_POST)

# Calculate delta estimator of heterozygosty (deltaH) from Diez-Del-Molino et al. 2018
# Absolute delta = het_POST - het_PRE
abs_delta <- median(het_POST) - median(het_PRE)
abs_delta
  
# Relative delta: DeltaH = ((median het of current pop) - (median het of old pop))/(median het of old pop)
relative_delta <-  (median(het_POST) - median(het_PRE))/(median(het_PRE)) * 100
relative_delta


  

