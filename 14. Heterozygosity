## Step 5: Calculate heterozygosity, plot, and perform statistical comparisons in RStudio.

## Part 1: Calculating heterozygosity per sample
# Set working directory
setwd("/path/to/workdir")

# Install and load packages
install.packages("dplyr", "ggplot2", "scales")
library(dplyr)
library(ggplot2)
library(scales)

# Load and explore data
all_sfs_v2 <- read.table("all_v2.ml", header = FALSE, sep = "")
str(all_sfs_v2)
head(all_sfs_v2)

# Add column names
colnames(all_sfs_v2) <- c("Sample", "HomRef", "Het", "HomAlt")
head(all_sfs_v2)

# Calculate heterozygosity for each sample
het_table_v2 <- all_sfs_v2 %>%
  mutate(Heterozygosity = Het / (HomRef + Het + HomAlt)) %>%
  select(Sample, Heterozygosity)
head(het_table_v2)

#Calculate heterozygosity per sample with different error estimators (st dev, st error, 95% confidence intervals)
het_summary <- het_table_v2 %>%
  group_by(Sample) %>%
  summarise (
    mean_het = mean(Heterozygosity), #calculates mean heterozygosity per sample
    stdev_het = sd(Heterozygosity), #calculates standard deviation (spread of data around its mean)
    sterr_het = stdev_het / sqrt(n()) #calculates the uncertainty of the estimated mean
  )
head(het_summary)

# Save the table
write.table(het_summary, "heterozygosity_2x_100boots_stats.csv", row.names = FALSE, quote = FALSE, sep = "\t")

