# Realignment around indels with GATK IndelRealigner
# Program: GATK v3.8.1.0
# Requires two steps: (1) creating the target intervals and (2) realignment. 

# All cluster jobs were performed on Puhti, CSC supercomputer: https://csc.fi/en/

######################################################################################
## Step 1: Creating target intervals

#!/bin/bash
#SBATCH --job-name=indelreal_step1_RealignerTargetCreator
#SBATCH --output=indelreal_step1_RealignerTargetCreator_out_%j.txt
#SBATCH --error=indelreal_step1_RealignerTargetCreator_err_%j.txt
#SBATCH --account=<name>
#SBATCH --partition=small
#SBATCH --time=72:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=10G #5G is enough. if decreasing total memory, decrease java memory ("-Xmx8G")

#Useful page with info: https://nodepit.com/node/de.helmholtz_muenchen.ibis.ngs.gatkrealignment.GATKRealignmentNodeFactory

echo "Defining paths and variables"
ref_genome="/path/to/reference_genome.fna"
input_dir="/path/to/bam_files"
out_dir="/path/to/save/results"
gatk="/path/to/GenomeAnalysisTK.jar"

mkdir -p $out_dir

echo "Loading biojava module..." #for csc supercomputer
module load biojava

echo "Starting a for loop for RealignerTargetCreator for each sample"
for bamfile in ${input_dir}/*.bam
do
echo "Extracting file name"
filename=$(basename $bamfile .bam)

echo "Processing sample: $filename"
java -Xmx8G -jar $gatk \
-T RealignerTargetCreator \
-R $ref_genome \
-I $bamfile \
-o $out_dir/${filename}.intervals \
-nt 4

echo "Target indel intervals created for $filename!"
done
echo "All samples processed!"

