######################################################################################
## Step 2: Realignment

#!/bin/bash
#SBATCH --job-name=indelreal_step2_IndelRealigner
#SBATCH --output=indelreal_step2_IndelRealigner_out_%j.txt
#SBATCH --error=indelreal_step2_IndelRealigner_err_%j.txt
#SBATCH --account=<name>
#SBATCH --partition=small
#SBATCH --time=72:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=6G

echo "Defining paths and variables"
ref_genome="/path/to/reference_genome.fna"
gatk="/path/to/GenomeAnalysisTK.jar"
bam_dir="/path/to/bam_files"
intervals_dir="path/to/intervals_from_step1"
out_dir="/path/to/save/results"

mkdir -p $out_dir

echo "Loading biojava module..." #for csc
module load biojava

echo "Starting a for loop for RealignerTargetCreator for each sample"
for bamfile in ${bam_dir}/*.bam
do
echo "Extracting file name"
filename=$(basename $bamfile .bam)

echo "Processing sample: $filename"
java -Xmx4G -jar $gatk -T IndelRealigner \
-R $ref_genome \
-I $bamfile \
-targetIntervals $intervals_dir/${filename}.intervals \
-o $out_dir/${filename}_indelRealigned.bam

echo "Realignment complete for $filename!"
done
echo "All samples processed!"

