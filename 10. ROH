# Runs of homozygosity (ROH) analysis with RZooROH. 

# Programs: AWK, RZooROH v.0.4.1, RStudio v.2025.05.0

# RZooROH package description: Bertrand AR, Kadri NK, Flori L, Gautier M, Druet T. RZooRoH: An R package to characterize individual genomic autozygosity and identify homozygous-by-descent segments. Methods Ecol Evol. 2019; 10: 860–866. https://doi.org/10.1111/2041-210X.13167
# Note that in RZooROH, the input file corresponding to ANGSD's genotype likelihoods format is called "genotype probability". 

# The analysis comprises two steps: formatting the input file (angsd -> rzooroh), and running RZooROH. 

# All cluster jobs were performed on Puhti, CSC supercomputer: https://csc.fi/en/

######################################################################################
## Step 1: Format beagle output file with GLs from ANGSD to RZooROH format
#!/bin/bash
#SBATCH --job-name=beagleGL_2x
#SBATCH --output=beagleGL_2x_%j.txt
#SBATCH --error=beagleGL_2x_%j.txt
#SBATCH --account=<name>
#SBATCH --partition=small
#SBATCH --time=72:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=3M
#SBATCH --nodes=1

echo "Defining paths and variables..."
beagle_input="/path/to/beagle_file" #zipped beagle file (.beagle.gz) with GLs produced with ANGSD (https://github.com/ekarabanina/lcWGS-genomic-erosion-pipeline/blob/909dc847dca08b61648b41b334182dbfc463da22/09.%20Estimating%20genotype%20likelihoods)
out_dir="/path/to/save/results"

mkdir -p $out_dir

echo "Running awk to keep only autosomes and split chr and position to own columns..."
gunzip -c $beagle_input |\
awk '
NR == 1 {
    # Modify header line
    printf "chr\tpos";
    for (i = 2; i <= NF; i++) {
        printf "\t%s", $i;
    }
    print "";
    next;
}
{
    # Split marker into chr and pos: In my case, the chromosomes are in a format "NC_044004.1", so the split needs to be at the second underscroe, which separates the chromosome name and the position (e.g., NC_044004.1_83, where NC_044004.1 is chromosome, and 82 is position).
    split($1, a, "_");
    chr = a[1] "_" a[2];
    pos = a[3];
    printf "%s\t%s", chr, pos;
    for (i = 2; i <= NF; i++) {
        printf "\t%s", $i;
    }
    print "";
}' | gzip > $out_dir/gl_2x.ROH.beagle.gz

