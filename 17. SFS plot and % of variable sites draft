## Step 4: Calculate percentage of variable sites (done in RStudio)
# Below, the script is for one of the groups (PRE). Similarly, analysis is done for all other groups.

# Calculating the percentage of variable sites is done as (1-monomorphic)*100%

# Load data
sfs_PRE <- scan("/path/to/realsfs_output_PRE.ml") #the file produced in Step 3 above, with .ml extension

# First, normalize data, including monomorphic sites. Original SFS is counts. Normalization transforms the data into frequencies.
norm <- function(x) x/sum(x)
sfs_PRE_norm_all <- norm(sfs_PRE)
sfs_PRE_norm_all

# Calculate percentage of variable sites (pvar)
pvar_PRE <- (1-sfs_PRE_norm_all[1])*100
pvar_PRE

######################################################################################
## Step 5: Plot SFS (in RStudio)

# Load data
sfs_PRE <- scan("/path/to/realsfs_output_PRE.ml")
sfs_BOT <- scan("/path/to/realsfs_output_BOT.ml")
sfs_POST <- scan("/path/to/realsfs_output_POST.ml")

# Perform normalization for POLYMORPHIC sites to see values as proportions instead of counts
norm <- function(x) x/sum(x)
sfs_PRE_norm <- norm(sfs_PRE[-c(1)])
sfs_BOT_norm <- norm(sfs_BOT[-c(1)])
sfs_POST_norm <- norm(sfs_POST[-c(1)])

# Combine data
combined_data <- rbind(sfs_PRE_norm, sfs_BOT_norm, sfs_POST_norm) #rbind is row binding, cbins is column binding
combined_data

allele_freq_class <- as.character(1:14) #here, there are 14 classes, because I was using 7 individuals from each group, which totals to 14 gene copies.

# Identify columns where all groups are zero (I am using folded SFS, so half of frequency classes from angsd output appear as zeros)
nonzero_idx <- colSums(combined_data) > 0

# Subset data and corresponding names
combined_data_nonzero <- combined_data[, nonzero_idx]
allele_freq_class_nonzero <- allele_freq_class[nonzero_idx]

# Plot
colour <- c("POST" = "#440154", "BOT" = "#FFDD44", "PRE" = "#21918c")
barplot(combined_data_nonzero, beside = TRUE,
        col = c(colour["PRE"], colour["BOT"], colour["POST"]), 
        legend = c("PRE", "BOT", "POST"),
        ylab = "Proportion", 
        xlab = "Minor allele frequency",
        main = "SFS plot", 
        names.arg = allele_freq_class_nonzero, #this displays numbers of freq classes on x-axis
        ylim = c(0, max(sfs_PRE_norm) * 1.1))
