## Step 3: Run realSFS to calculate 1-dimensional site frequency spectrum (SFS) for each group.
# Below is the example for one of the groups. Similarly, analysis is done for all other groups.

#!/bin/bash
#SBATCH --job-name=realsfs_PRE
#SBATCH --output=realsfs_PRE_%j.txt
#SBATCH --error=realsfs_PRE_%j.txt
#SBATCH --account=project_2006568
#SBATCH --partition=small
#SBATCH --time=72:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=10
#SBATCH --mem=55G
#SBATCH --nodes=1

echo "Defining paths and variables..."
dir="/path/to/doSaf_results" #from Step 2 above

echo "Loading angsd module..."
module load angsd

echo "Running realSFS..."
realSFS -cores 10 -fold 1 \
$dir/doSaf_PRE.saf.idx > $dir/realsfs_2x_PRE.ml \
2> $dir/realsfs_2x_PRE.errors

echo "Done!"

