# Comparing site frequency spectra (SFS) across groups and calculating the percentage of variable sites
# SFS can be plotted for groups with different sample sizes. However, my purpose was to visually compare the SFSs and percentage of variable sites across groups. For that, sample sizes should be the same. Here, I downsampled all groups to seven individuals. In SFS, seven diploid individuals totals 14 gene copies

# Programs: ANGSD 0.940, RStudio

# Steps:
# 1. Create bamlists for each group/populaton (unix shell)
# 2. Run doSaf per group (angsd)
# 3. Calculate 1-dimensional site frequency spectrum (SFS) for each group (angsd)
# 4. Calculate percentage of variable sites (RStudio) 
# 5. Plot SFS (RStudio)

# All cluster jobs were performed on Puhti, CSC supercomputer: https://csc.fi/en/

######################################################################################
## Step 1: Create bamlists for each group/populaton
# Bamlist is a text document that contains full paths to bam files belonging to the group of interest (here, PRE, BOT, POST). It can be created, for example, using the ls -1 command on unix shell:
ls -1 /dir/*.bam > bamlist_PRE.txt

######################################################################################
## Step 2: Run doSaf per group.
# Below is the example for one of the groups. Similarly, analysis is done for all other groups.

!/bin/bash
#SBATCH --job-name=doSaf_PRE
#SBATCH --output=doSaf_PRE_%j.txt
#SBATCH --error=doSaf_PRE_%j.txt
#SBATCH --account=<name>
#SBATCH --partition=small
#SBATCH --time=72:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=2G
#SBATCH --nodes=1

echo "Defining paths and variables..."
ref="/path/to/reference_genome.fna"
bamlist="/path/to/bamlist_PRE.txt"
out_dir="/path/to/save/results"

echo "Loading angsd module..."
module load angsd

echo "Running -doSaf..."
angsd -P 4 -bam $bamlist -anc $ref -ref $ref \
-out $out_dir/doSaf_2x_PRE \
-GL 1 -doSaf 1 \
-remove_bads 1 -uniqueOnly 1 -only_proper_pairs 1 \
-baq 1 -C 50 \
-minMapQ 30 -minQ 20 \
-doCounts 1 \
-minInd 5 \
-setMinDepthInd 1 -setMaxDepthInd 8 \
&> $out_dir/doSaf_2x_PRE.log

echo "Done!"

