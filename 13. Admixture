# Admixture analysis with ngsAdmix

# Programs: ngsAdmix, AWK, RStudio

# Details about ngsAdmix: https://www.popgen.dk/software/index.php/NgsAdmix

# All cluster jobs were performed on Puhti, CSC supercomputer: https://csc.fi/en/

# Admixture analysis was performed on a LD-pruned dataset of transversion SNPs for K = 1 to 5, each run with 100 iterations. Minor allele frequency (-minMaf) was set to 0.02, and minimum number of individuals with the SNP (-minInd) was set to 5. 

# Steps:
# 1. Run ngsAdmix for each K
# 2. Extract likelihood values and prepare an input file for R 
# 3. Estimate the most likely K in R
# 4. Visualize admixture proportions in R with pophelper package

######################################################################################
## Step 1: Run ngsAdmix for each K
# This step can be performed as an array job to run each K simultaneously, or one by one. Below is the code for each K individually, with the example of K = 2. Repeat for other Ks accordingly. 
#!/bin/bash
#SBATCH --job-name=ngsAdmix_K2_100iter
#SBATCH --output=ngsAdmix_K2_100iter_%j.txt
#SBATCH --error=ngsAdmix_K2_100iter_%j.txt
#SBATCH --account=<name>
#SBATCH --partition=small
#SBATCH --time=72:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=10
#SBATCH --mem=20G

echo "Defining paths and variables..."
input="/path/to/input/file" #a zipped beagle file with GLs (LD-pruned)
out_dir="/path/to/save/results"

mkdir -p $out_dir

echo "Loading angsd module..." #for csc
module load angsd

# Limit the number of runs at a time to balance resources
max_jobs=10 
jobcount=0

echo "Running ngsAdmix..."
for run in {1..100}
do
echo "Running K=2, run=$run..."
NGSadmix -P 1 \
-likes $input \
-K 2 \
-o $out_dir/ngsAdmix2_k2_r${run} \
-minMaf 0.02 \
-minInd 5 \
&>> $out_dir/ngsAdmix2_K2.log &

((jobcount++))
if (( jobcount % max_jobs == 0 )); then
wait
echo "Completed $jobcount jobs..."
fi

done
wait
echo "Done!"

